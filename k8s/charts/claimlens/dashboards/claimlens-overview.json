   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "What the HPAs act on: usage over the CPU request (their targets are 70%).",
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 19
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "custom": {
      "lineWidth": 2,
