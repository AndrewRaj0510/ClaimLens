  {
   "type": "timeseries",
   "title": "Backlog (stream lag)",
   "id": 7,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "KEDA's reading of the consumer group's lag: entries not yet delivered to any worker.",
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 10
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(keda_scaler_metrics_value{scaledObject=\"vision-worker\",exported_namespace=\"$namespace\"})",
     "legendFormat": "entries waiting",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Jobs per second by outcome",
   "id": 8,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
