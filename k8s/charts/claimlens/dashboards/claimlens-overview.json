   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (deployment) (label_replace(rate(container_cpu_usage_seconds_total{namespace=\"$namespace\",container!=\"\",container!=\"POD\"}[1m]), \"deployment\", \"$1\", \"pod\", \"(.*)-[a-z0-9]+-[a-z0-9]{5}\")) / sum by (deployment) (label_replace(kube_pod_container_resource_requests{namespace=\"$namespace\",resource=\"cpu\"}, \"deployment\", \"$1\", \"pod\", \"(.*)-[a-z0-9]+-[a-z0-9]{5}\"))",
     "legendFormat": "{{deployment}}",
     "refId": "A"
    }
   ]
