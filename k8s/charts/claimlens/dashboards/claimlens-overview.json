  "from": "now-30m",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "namespace",
    "label": "Namespace",
    "type": "custom",
    "query": "claimlens",
    "current": {
     "text": "claimlens",
     "value": "claimlens"
    },
    "options": [
     {
      "text": "claimlens",
      "value": "claimlens",
      "selected": true
     }
    ]
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Traffic (the edge, and the services with /metrics: gateway, agent, guardrails)",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Edge: NGINX requests and connections",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "NGINX Gateway Fabric's data plane: everything that came in, pages and API, before any app code.",
   "gridPos": {
    "h": 8,
    "w": 6,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(nginx_http_requests_total{namespace=\"$namespace\"}[2m]))",
     "legendFormat": "requests/s",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(nginx_http_connection_count_connections{namespace=\"$namespace\",nginx_connections_outcome=\"ACTIVE\"})",
     "legendFormat": "active connections",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Requests per second",
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "From each service's own http_requests_total, by Kubernetes service.",
   "gridPos": {
    "h": 8,
    "w": 6,
    "x": 6,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (service) (rate(http_requests_total{namespace=\"$namespace\"}[1m]))",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "5xx share",
   "id": 4,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "",
   "gridPos": {
    "h": 8,
    "w": 6,
    "x": 12,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (service) (rate(http_requests_total{namespace=\"$namespace\",status=~\"5..\"}[2m])) / sum by (service) (rate(http_requests_total{namespace=\"$namespace\"}[2m]))",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "p95 latency by route",
   "id": 5,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "95th percentile per route template, over 2 minutes.",
   "gridPos": {
    "h": 8,
    "w": 6,
    "x": 18,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0,
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, service, route) (rate(http_request_duration_seconds_bucket{namespace=\"$namespace\",route!=\"unmatched\"}[2m])))",
     "legendFormat": "{{service}} {{route}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "row",
   "title": "Vision queue (KEDA scales the workers on the backlog)",
   "id": 6,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 9
   },
   "panels": []
