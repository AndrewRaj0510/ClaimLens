# Copy to .env (git-ignored) and fill in. docker compose reads .env automatically.

# Postgres. Pick any long random password; it never leaves your machine.
POSTGRES_PASSWORD=change-me
# Host port for local tools (psql, the loader and ingest scripts). Bound to 127.0.0.1 only.
POSTGRES_PORT=5433

# For scripts run on your machine (loader, ingest, DB tests). Containers get
# their own URL from docker-compose.yml. ${...} is expanded by python-dotenv.
DATABASE_URL=postgresql://claimlens:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/claimlens

# Redis (job queue). Published on 127.0.0.1 only, for tests.
REDIS_PASSWORD=change-me
REDIS_PORT=6380

# S3-compatible object storage (SeaweedFS locally). Without credentials
# SeaweedFS would allow anonymous access, so these are required.
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=claimlens

# Shared key for the adjuster-only decision endpoint (X-Adjuster-Key header),
# until real authentication arrives in Phase 3. Empty or shorter than 16
# characters = decisions locked. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
ADJUSTER_API_KEY=

# LLM for the agent (Ollama Cloud). Create a key at https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b
