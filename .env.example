# Copy to .env (git-ignored) and fill in. docker compose reads .env automatically.

# Postgres. Pick any long random password; it never leaves your machine.
POSTGRES_PASSWORD=change-me
# Host port for local tools (psql, the loader and ingest scripts). Bound to 127.0.0.1 only.
POSTGRES_PORT=5433

# For scripts run on your machine (loader, ingest, DB tests). Containers get
# their own URL from docker-compose.yml. ${...} is expanded by python-dotenv.
DATABASE_URL=postgresql://claimlens:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/claimlens

# One database role per service (db/roles.sql), each with its own password.
# Long random values, e.g. python -c "import secrets; print(secrets.token_urlsafe(24))"
# (URL-safe: they go into connection URLs). On a database created before
# Phase 4, run python scripts/apply_db_roles.py after setting them.
DB_PASSWORD_GATEWAY=change-me
DB_PASSWORD_AGENT=change-me
DB_PASSWORD_POLICY=change-me
DB_PASSWORD_PRICING=change-me
DB_PASSWORD_CLAIMS_HISTORY=change-me

# Redis (job queue). Published on 127.0.0.1 only, for tests.
REDIS_PASSWORD=change-me
REDIS_PORT=6380

# S3-compatible object storage (SeaweedFS locally). Without credentials
# SeaweedFS would allow anonymous access, so these are required.
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=claimlens

# Logins live in Postgres (auth.users); create them with
#   python scripts/create_users.py --adjuster sam --demo-customers 3
# Session cookies are Secure only when this is true. Local compose serves
# plain HTTP, so it defaults to false there; set true behind TLS.
COOKIE_SECURE=false

# LLM for the agent (Ollama Cloud). Create a key at https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b
# Vision model that compares the (redacted) photos with the description.
VLM_MODEL=qwen3-vl:235b-instruct
